{
  "name": "scrape-studio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 visual workbench for ScrapeStudio",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
