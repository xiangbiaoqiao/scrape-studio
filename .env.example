# Copy this file to `.env` before running `docker compose up --build`.

# Port the web UI is published on.
WEB_PORT=8088

# Database password used by both PostgreSQL and the backend.
POSTGRES_PASSWORD=change-me-postgres

# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Shared secret between the backend and the Playwright worker.
WORKER_TOKEN=change-me-worker-token

# Public origin of the app, used to build screenshot URLs.
# Keep it in sync with WEB_PORT and your reverse proxy domain.
PUBLIC_BASE_URL=http://localhost:8088

# Comma-separated origins allowed by the backend CORS filter.
CORS_ORIGINS=http://localhost:8088

# Seed the demo account and sample projects on first boot.
# Set to false for a clean production workspace.
DEMO_ENABLED=true
